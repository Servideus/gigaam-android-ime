<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/imeSurface"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnNextIme"
            style="@style/ImeToolbarIconButton"
            android:contentDescription="@string/ime_button_next_ime_desc"
            android:src="@android:drawable/ic_menu_rotate" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/ImeToolbarIconButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ime_button_settings_desc"
            android:src="@android:drawable/ic_menu_manage" />

        <TextView
            android:id="@+id/txtImeStatus"
            style="@style/ImeStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ime_status_idle" />

        <ImageButton
            android:id="@+id/btnMicAction"
            style="@style/ImeToolbarPrimaryButton"
            android:contentDescription="@string/ime_button_mic_idle_desc"
            android:src="@android:drawable/ic_btn_speak_now" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDigits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="1" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="2" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="3" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="4" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="5" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="6" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="7" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="8" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="9" />

        <Button
            style="@style/ImeDigitKey"
            android:layout_weight="1"
            android:text="0" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLetters1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="й" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ц" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="у" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="к" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="е" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="н" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="г" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ш" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="щ" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="з" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="х" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ъ" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLetters2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ф" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ы" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="в" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="а" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="п" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="р" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="о" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="л" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="д" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ж" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="э" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ё" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLetters3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnShift"
            style="@style/ImeSpecialIconKey"
            android:layout_weight="1.25"
            android:contentDescription="@string/ime_shift_off_desc"
            android:src="@drawable/ic_shift_inactive_outline" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="я" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ч" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="с" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="м" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="и" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="т" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ь" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="б" />

        <Button
            style="@style/ImeLetterKey"
            android:layout_weight="1"
            android:text="ю" />

        <Button
            android:id="@+id/btnBackspace"
            style="@style/ImeSpecialKey"
            android:layout_weight="1.25"
            android:text="@string/ime_key_backspace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSymbols"
            style="@style/ImeSpecialKey"
            android:layout_weight="1.25"
            android:text="@string/ime_key_symbols" />

        <Button
            android:id="@+id/btnComma"
            style="@style/ImeSpecialKey"
            android:layout_weight="0.95"
            android:text="," />

        <Button
            android:id="@+id/btnLanguage"
            style="@style/ImeSpecialKey"
            android:layout_weight="0.95"
            android:text="@string/ime_key_language_ru" />

        <Button
            android:id="@+id/btnSpace"
            style="@style/ImeSpecialKey"
            android:layout_weight="3.2"
            android:contentDescription="@string/ime_key_space_desc"
            android:text="" />

        <Button
            android:id="@+id/btnPeriod"
            style="@style/ImeSpecialKey"
            android:layout_weight="0.95"
            android:text="." />

        <ImageButton
            android:id="@+id/btnEnter"
            style="@style/ImeSpecialIconKey"
            android:layout_weight="1.25"
            android:contentDescription="@string/ime_key_enter_desc"
            android:src="@drawable/ic_enter_large" />
    </LinearLayout>
</LinearLayout>
